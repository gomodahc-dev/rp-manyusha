# Скопируй в .env и вставь ключи из Supabase (Project Settings -> API).
# Без них игра работает локально: Forbes только на этом устройстве,
# глобальные лимиты промо считаются per-device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Донат: ссылка на оплату (Lava.top / CrystalPay / твой Telegram-бот).
# Пример: VITE_PAY_BASE_URL=https://lava.top/shop/XXXX
# К ней допишутся ?pack=ID&sum=СУММА&player=PLAYERID автоматически.
# Пусто = кнопка создаёт заявку без перехода, оплату берёшь вручную.
VITE_PAY_BASE_URL=
# Контакт для вопросов по оплате, напр. @manyusha_admin
VITE_ADMIN_CONTACT=
